# Copie para .env e preencha. O .env esta no .gitignore e nao deve ser commitado.
#
# DISCORD_BOT_TOKEN
#   discord.com/developers/applications > New Application > Bot > Reset Token.
#   O token aparece UMA vez. Se vazar, e so resetar - nao ha dano permanente.
#
# DISCORD_GUILD_ID
#   No Discord: Configuracoes > Avancado > Modo desenvolvedor ligado.
#   Clique com o botao direito no nome do servidor > Copiar ID do servidor.

DISCORD_BOT_TOKEN= 
DISCORD_GUILD_ID=
CANAL_PRAZOS=editais-e-prazos
